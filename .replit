modules = ["nodejs-24", "postgresql-16", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "AlGhareeb Card Frontend"

[[workflows.workflow]]
name = "AlGhareeb Card Frontend"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/alghareeb-card run dev"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 4200

[[ports]]
localPort = 8083
externalPort = 80

[[ports]]
localPort = 20907
externalPort = 3002

[[ports]]
localPort = 20908
externalPort = 3003

[[ports]]
localPort = 20909
externalPort = 5000

[[ports]]
localPort = 20910
externalPort = 3000

[[ports]]
localPort = 20911
externalPort = 3001

[nix]
channel = "stable-25_05"
